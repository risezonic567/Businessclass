# Local default 5001 to avoid clash with GTH on 5000. Docker image still EXPOSE 5000 (compose maps 5001:5000).
PORT=5001
DUFFEL_API=your_duffel_token_here
# Local Mongo: mongodb://127.0.0.1:27017/businessclass
# Docker Compose: mongodb://mongo:27017/businessclass
MONGO_URL=mongodb://127.0.0.1:27017/businessclass
USER_EMAIL=your_gmail@gmail.com
EMAIL_PASS_ID=your_gmail_app_password
QUOTE_TO_EMAIL=info@asktravelo.com
FRONTEND_URL=https://www.business-classflights.com
